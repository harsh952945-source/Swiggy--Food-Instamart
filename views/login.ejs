<%- include('partials/header', { pageTitle: 'Login' }) %>

<div class="wrap">
  <div class="form-card">
    <h2>Welcome back</h2>
    <p class="sub">Log in to order food and groceries.</p>
    <% if (error) { %><div class="form-error"><%= error %></div><% } %>
    <form action="/login" method="POST">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Log In</button>
    </form>
    <p class="form-alt">New to ZappyEats? <a href="/register">Create an account</a></p>
    <p class="form-alt" style="font-size:0.82rem;">Demo login: demo@zappyeats.com / demo1234</p>
  </div>
</div>

<%- include('partials/footer') %>
