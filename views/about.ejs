<%- include('partials/header', { pageTitle: 'About' }) %>
<div class="wrap section-pad" style="max-width:760px;">
  <h2>About ZappyEats</h2>
  <p style="color:var(--ink-soft);">ZappyEats is a food delivery and instant-grocery platform built as a BCA final-year project. Customers can order from restaurants (Food) or shop groceries and essentials (Instamart) from one place.</p>
  <h3 style="margin-top:26px;">What it includes</h3>
  <ul style="line-height:1.9;color:var(--ink-soft);">
    <li>Customer accounts, cart, checkout, coupons and live order tracking</li>
    <li>Favourites, ratings-ready vendor pages and a helpful chat assistant</li>
    <li>Admin panel with sales charts, vendor/product/coupon/order management</li>
    <li>Built with Node.js, Express, EJS and SQLite</li>
  </ul>
</div>
