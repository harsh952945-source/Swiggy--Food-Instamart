<%- include('../partials/header', { pageTitle: 'Manage Orders' }) %>

<div class="admin-shell">
  <%- include('../partials/admin-side', { active: 'orders' }) %>
  <div class="admin-main">
    <h2>Orders</h2>
    <table class="admin-table">
      <thead><tr><th>#</th><th>Customer</th><th>Vendor</th><th>Total</th><th>Payment</th><th>Placed</th><th>Status</th></tr></thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= o.user_name %></td>
            <td><%= o.vendor_name %></td>
            <td>₹<%= o.total.toFixed(0) %></td>
            <td><%= o.payment_method %></td>
            <td><%= new Date(o.created_at).toLocaleString() %></td>
            <td>
              <form action="/admin/orders/<%= o.id %>/status" method="POST" style="display:flex;gap:6px;align-items:center;">
                <select name="status" onchange="this.form.submit()">
                  <% ['Placed','Confirmed','Preparing','Out for Delivery','Delivered','Cancelled'].forEach(s => { %>
                    <option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer', { minimal: true }) %>
