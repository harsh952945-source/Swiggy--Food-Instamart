<%- include('../partials/header', { pageTitle: 'Change Password' }) %>

<div class="admin-shell">
  <%- include('../partials/admin-side', { active: 'password' }) %>
  <div class="admin-main">
    <h2>Change admin login</h2>
    <p style="color:var(--ink-soft);margin-bottom:18px;">Signed in as <strong><%= email %></strong>. Enter your current password to change your email and/or password.</p>
    <% if (msg) { %><div class="admin-msg <%= msg.type %>"><%= msg.text %></div><% } %>
    <form action="/admin/password" method="POST" style="max-width:440px;" autocomplete="off">
      <div class="field"><label>Current password</label><input type="password" name="current_password" required></div>
      <div class="field"><label>New email (leave blank to keep <%= email %>)</label><input type="email" name="new_email" placeholder="<%= email %>"></div>
      <div class="field"><label>New password (min 6 characters)</label><input type="password" name="new_password" minlength="6"></div>
      <div class="field"><label>Confirm new password</label><input type="password" name="confirm_password" minlength="6"></div>
      <button class="btn btn-secondary" type="submit">Save changes</button>
    </form>
  </div>
</div>

<%- include('../partials/footer', { minimal: true }) %>
