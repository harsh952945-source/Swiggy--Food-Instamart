<%- include('../partials/header', { pageTitle: 'Admin Login' }) %>

<div class="wrap">
  <div class="form-card">
    <h2>Admin Login</h2>
    <p class="sub">ZappyEats management console</p>
    <% if (error) { %><div class="form-error"><%= error %></div><% } %>
    <form action="/admin/login" method="POST">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-secondary btn-block">Log In</button>
    </form>
    <p class="form-alt" style="font-size:0.82rem;">Demo admin: admin@zappyeats.com / admin123</p>
  </div>
</div>

<%- include('../partials/footer', { minimal: true }) %>
